---
import AppSim from "./sim/AppSim.astro";
import { asset } from "../data/site";

// Cada letra del nombre lleva un color de la mano del logo, como en la app.
const letterColors = ["text-coral", "text-violeta", "text-ambar", "text-verde", "text-azul"];
let colorIndex = 0;
const letters = [..."Soltá Ve"].map((ch) =>
  ch === " " ? { ch, color: "" } : { ch, color: letterColors[colorIndex++ % letterColors.length] },
);
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Manchas de color de fondo, en los tonos del logo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-crema blur-3xl"></div>
    <div class="absolute right-0 top-40 h-80 w-80 rounded-full bg-coral/15 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-violeta/15 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-20 pt-12 sm:px-6 md:grid-cols-[1.1fr_1fr] md:pt-20">
    <div>
      <p data-hero class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3 py-1 text-sm font-medium text-arena ring-1 ring-linea">
        <span class="h-2 w-2 rounded-full bg-verde"></span>
        Rehabilitación de mano y muñeca · Android y iPhone
      </p>

      <div class="mt-6 flex items-center gap-4">
        <img id="hero-logo" data-hero src={asset("/img/logo.png")} alt="Logo de Soltá Ve: una mano hecha de herramientas creativas" width="96" height="96" class="h-20 w-20 origin-bottom sm:h-24 sm:w-24" />
        <h1 class="font-display text-6xl font-semibold leading-none tracking-tight sm:text-7xl" aria-label="Soltá Ve">
          {letters.map(({ ch, color }) =>
            ch === " " ? <span aria-hidden="true" class="inline-block w-4"></span>
                       : <span aria-hidden="true" data-letter class={`inline-block origin-bottom ${color}`}>{ch}</span>
          )}
        </h1>
      </div>

      <p data-hero class="mt-6 font-display text-2xl font-medium text-tinta sm:text-3xl">
        Soltá la mano, volvé a crear.
      </p>
      <p data-hero class="mt-4 max-w-xl text-lg leading-relaxed text-arena">
        Una app interactiva de ejercicios para las muñecas. La cámara de tu celular detecta tu mano en tiempo real y te guía en
        cada postura, sin aparatos ni sensores extra. Pensada para quienes diseñan, dibujan, pintan y crean con las manos todo el día.
      </p>

      <div data-hero class="mt-8 flex flex-wrap gap-3">
        <a href="#descarga" data-button class="inline-flex items-center gap-2 rounded-full bg-coral px-6 py-3 font-semibold text-white shadow-lg shadow-coral/30">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22A11.5 11.5 0 0 0 12 8.08c-1.77 0-3.43.39-4.92 1.06L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="-ml-1 h-5 w-5 fill-current"><path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.65-.39 6.57 1.1 8.72.73 1.05 1.6 2.23 2.73 2.19 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.4 1.2-2.46-.03-.01-2.3-.88-2.3-3.47zM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21z"/></svg>
          Próximamente en Android y iPhone
        </a>
        <a href="#como-funciona" data-button class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-tinta ring-1 ring-linea">
          Conoce más
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
    </div>

    <!-- Dos teléfonos con la app simulada: modo claro adelante (se puede usar) y modo oscuro atrás -->
    <div class="relative mx-auto aspect-[5/6] w-full max-w-[22rem] sm:aspect-auto sm:h-[37rem] sm:max-w-md">
      <div id="hero-phone-back" data-hero class="absolute right-[4%] top-0 w-[46%] rotate-6 sm:right-0 sm:w-[50%]">
        <AppSim theme="dark" start="inicio" pages={["inicio"]} label="La app Soltá Ve en modo oscuro" />
      </div>
      <div id="hero-phone-front" data-hero class="absolute bottom-0 left-[4%] w-[50%] -rotate-3 sm:left-2 sm:w-[56%]">
        <AppSim theme="light" start="inicio" mode="interactive" label="La app Soltá Ve en modo claro. Puedes tocarla y navegar." />
      </div>
    </div>
  </div>
</section>
