---
import AppSim from "./sim/AppSim.astro";

/*
 * Recorrido con scroll: el teléfono queda fijo y la app simulada avanza por sus funciones a medida que se baja.
 * page = pantalla de la app; hl = elemento que se resalta (data-hl dentro de la pantalla); action = qué hace la app
 * en ese paso. Las animaciones están en src/scripts/walkthrough.ts.
 */
const steps = [
  { page: "inicio", hl: "", action: "tour", color: "#ff5a3c", title: "Un recorrido para empezar", text: "La primera vez que abres la app, la pantalla se oscurece y te explica cada sección, una por una. Puedes repetirlo cuando quieras con el botón «?»." },
  { page: "inicio", hl: "hoy", action: "", color: "#ff5a3c", title: "Tu terapia de hoy", text: "Inicio te dice cuánto te falta de la rutina del día, cuántos días llevas de racha y te da un consejo de ergonomía nuevo cada día." },
  { page: "terapia", hl: "ex-pinza_oposicion", action: "open:pinza_oposicion", color: "#5bb4ea", title: "Cinco ejercicios, una rutina", text: "En Terapia están los cinco ejercicios. Toca uno para ver cómo se hace y para qué sirve, y empieza cuando estés listo." },
  { page: "tutorial-pinza_oposicion", hl: "ejemplo", action: "", color: "#a68fe3", title: "Una guía animada", text: "Antes de cada ejercicio, una mano animada te muestra las posturas en bucle y al ritmo real, para que sepas exactamente qué hacer." },
  { page: "ejercicio", hl: "ejercicio", action: "run:separacion_dedos", color: "#f5b841", title: "La app te marca el ritmo", text: "Durante el ejercicio, la app cuenta los segundos de cada postura y las rondas. En «Abre y cierra la mano», la cámara reconoce tu mano con MediaPipe y cuenta las repeticiones, sin grabar ni enviar imágenes." },
  { page: "completada", hl: "completada", action: "", color: "#6fd08c", title: "Cada sesión cuenta", text: "Al terminar ves tus repeticiones, el tiempo de la sesión y cómo avanza tu racha." },
  { page: "rachas", hl: "calendario", action: "", color: "#f5b841", title: "Rachas y logros", text: "Un calendario con tus días activos y las rutinas completas, e insignias que ganas por constancia, repeticiones y sesiones." },
  { page: "historial", hl: "grafica", action: "", color: "#a68fe3", title: "Historial y reporte en PDF", text: "Tus sesiones con gráficas por día, mes y año, y un reporte clínico en PDF para llevarle a tu fisioterapeuta o médico." },
  { page: "perfil", hl: "destacados", action: "", color: "#ff5a3c", title: "Tu perfil, a tu manera", text: "Tu foto, tus logros destacados y los ajustes: tema claro u oscuro, recordatorios, tus datos y tu cuenta." },
];
---

<section id="paso-a-paso" class="relative scroll-mt-16 bg-white/50 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="font-display text-lg font-semibold text-coral">Paso a paso</p>
      <h2 class="mt-2 font-display text-4xl font-semibold leading-tight sm:text-5xl">Así se usa Soltá Ve</h2>
      <p class="mt-4 text-lg leading-relaxed text-arena">Desliza y mira la app funcionando: cada paso abre la pantalla real y resalta la función que se explica.</p>
    </div>

    <div class="mt-10 grid gap-6 md:mt-4 md:grid-cols-2 md:gap-16">
      <!-- Teléfono fijo con la app simulada -->
      <div class="sticky top-16 z-10 flex h-[48vh] flex-col items-center justify-center self-start bg-papel/95 pb-3 pt-2 backdrop-blur md:top-0 md:h-screen md:bg-transparent md:backdrop-blur-none">
        <div id="wt-phone" class="w-[min(70vw,calc(40vh*0.47))] md:w-[min(340px,calc(80vh*0.47))]">
          <AppSim mode="guided" start="inicio" label="La app Soltá Ve mostrando la función que se explica" />
        </div>
        <div class="mt-3 flex items-center gap-3">
          <span id="wt-count" class="w-24 text-right font-display text-sm font-semibold text-arena">Paso 1 de {steps.length}</span>
          <div class="flex gap-1.5">
            {steps.map((_, i) => (
              <button type="button" data-wt-dot={i} aria-label={`Ir al paso ${i + 1}`} class="h-2 w-2 rounded-full bg-linea transition-all"></button>
            ))}
          </div>
        </div>
      </div>

      <!-- Pasos. En celular cada tarjeta va al fondo de su paso, debajo del teléfono fijo. -->
      <ol class="relative">
        {steps.map((s, i) => (
          <li data-wt-step={i} data-page={s.page} data-hl={s.hl} data-action={s.action} data-color={s.color} class="flex min-h-[75vh] items-end pb-4 md:min-h-[85vh] md:items-center md:pb-0">
            <article data-wt-card class="w-full rounded-3xl bg-white p-5 shadow-sm ring-1 ring-linea transition-opacity duration-500 md:p-7">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full font-display text-lg font-semibold text-white md:h-10 md:w-10" style={`background:${s.color}`}>{i + 1}</span>
              <h3 class="mt-3 font-display text-xl font-semibold sm:text-3xl md:mt-4">{s.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-arena sm:text-lg md:mt-3">{s.text}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  [data-wt-dot][aria-current="step"] {
    width: 1.25rem;
    background: var(--color-coral);
  }
</style>

<script>
  import "../scripts/walkthrough";
</script>
