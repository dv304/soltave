---
import PhoneFrame from "./PhoneFrame.astro";

const screens = [
  { id: "inicio", label: "Inicio" },
  { id: "terapia", label: "Terapia" },
  { id: "ejercicio", label: "Ejercicio" },
  { id: "rachas", label: "Rachas" },
  { id: "perfil", label: "Perfil" },
];
---

<section id="pantallas" class="scroll-mt-20 bg-cafe py-20 text-papel">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div data-reveal class="max-w-xl">
        <p class="font-display text-lg font-semibold text-ambar">La app</p>
        <h2 class="mt-2 font-display text-4xl font-semibold leading-tight sm:text-5xl">Clara de día, cómoda de noche</h2>
        <p class="mt-4 text-lg leading-relaxed text-papel/70">Modo claro y oscuro con la misma identidad. Cambia el modo para ver cada pantalla.</p>
      </div>

      <!-- Interruptor claro/oscuro: cambia todas las capturas de la galería -->
      <div data-reveal role="group" aria-label="Modo de las pantallas" class="inline-flex rounded-full bg-white/10 p-1">
        <button type="button" data-mode-btn="claro" aria-pressed="true" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-pressed:bg-papel aria-pressed:text-tinta">Claro</button>
        <button type="button" data-mode-btn="oscuro" aria-pressed="false" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-pressed:bg-papel aria-pressed:text-tinta">Oscuro</button>
      </div>
    </div>

    <div data-stagger class="mt-12 flex snap-x gap-5 overflow-x-auto pb-6 [scrollbar-width:thin] md:grid md:grid-cols-5 md:overflow-visible">
      {screens.map((s) => (
        <figure class="w-44 shrink-0 snap-center md:w-auto">
          <PhoneFrame src={`/img/app/${s.id}-claro.png`} alt={`Pantalla ${s.label} de Soltá Ve`} data-screen={s.id} />
          <figcaption class="mt-3 text-center font-display text-lg font-medium text-papel/80">{s.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
