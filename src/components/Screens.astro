---
import AppSim from "./sim/AppSim.astro";

const hints = [
  "Cambia de pestaña en la barra de abajo.",
  "En Terapia, toca un ejercicio y pulsa «Empezar ejercicio».",
  "Haz la rutina: la mano te marca cada postura y el tiempo.",
  "Toca «?» en Inicio para ver el recorrido de la app.",
];
---

<section id="pantallas" class="scroll-mt-20 bg-cafe py-20 text-papel">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-[1fr_auto]">
    <div data-reveal class="max-w-xl">
      <p class="font-display text-lg font-semibold text-ambar">Pruébala</p>
      <h2 class="mt-2 font-display text-4xl font-semibold leading-tight sm:text-5xl">La app, aquí mismo</h2>
      <p class="mt-4 text-lg leading-relaxed text-papel/70">
        Este teléfono es la app funcionando: navega por sus pantallas, abre un ejercicio y haz la rutina guiada, en modo claro u oscuro.
      </p>

      <!-- Interruptor claro/oscuro del teléfono -->
      <div role="group" aria-label="Modo de la app" class="mt-8 inline-flex rounded-full bg-white/10 p-1">
        <button type="button" data-mode-btn="light" aria-pressed="true" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-pressed:bg-papel aria-pressed:text-tinta">Claro</button>
        <button type="button" data-mode-btn="dark" aria-pressed="false" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-pressed:bg-papel aria-pressed:text-tinta">Oscuro</button>
      </div>

      <ul data-stagger class="mt-8 space-y-3 text-papel/80">
        {hints.map((h, i) => (
          <li class="flex items-start gap-3"><span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/10 font-display text-sm font-semibold text-ambar">{i + 1}</span>{h}</li>
        ))}
      </ul>
    </div>

    <div data-reveal id="try-phone" class="mx-auto w-[min(86vw,340px)]">
      <AppSim mode="interactive" start="inicio" label="La app Soltá Ve. Puedes tocarla y navegar por sus pantallas." />
    </div>
  </div>
</section>
