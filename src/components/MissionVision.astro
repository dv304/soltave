---
const blocks = [
  {
    id: "mision",
    title: "Misión",
    text: "Facilitar la rehabilitación de muñeca a través de una aplicación interactiva que elimina las barreras del abandono terapéutico. Soltá Ve transforma los ejercicios monótonos en rutinas guiadas y gamificadas mediante detección de movimiento, acompañando al usuario para que recupere la salud de sus manos sin interrumpir su flujo de trabajo.",
    accent: "bg-coral",
    tint: "bg-coral/10",
  },
  {
    id: "vision",
    title: "Visión",
    text: "Ser la plataforma digital de referencia en prevención ergonómica y bienestar físico para quienes crean con sus manos. Aspiramos a instaurar un hábito de autocuidado integral donde la tecnología móvil evite el desgaste articular crónico, garantizando que el dolor nunca sea un límite para la creatividad.",
    accent: "bg-violeta",
    tint: "bg-violeta/10",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <div data-stagger class="grid gap-5 md:grid-cols-2 md:gap-6">
    {blocks.map((b) => (
      <article id={b.id} class={`scroll-mt-24 rounded-3xl p-6 sm:p-10 ${b.tint}`}>
        <span class={`inline-block h-1.5 w-12 rounded-full ${b.accent}`}></span>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-4xl">{b.title}</h2>
        <p class="mt-3 text-base leading-relaxed text-tinta/80 sm:text-lg">{b.text}</p>
      </article>
    ))}
  </div>
</section>
