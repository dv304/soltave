---
import { asset } from "../data/site";

/**
 * Captura de la app dentro de un marco de teléfono.
 * Cada captura conserva su alto real ([h], en píxeles de la imagen de 824 de ancho) para que no se corte la barra
 * inferior. Las pantallas que se desplazan (rachas, historial) se recortan a la altura de un teléfono con [crop].
 */
interface Props {
  src: string;
  alt: string;
  h?: number;
  crop?: boolean;
  class?: string;
  eager?: boolean;
  [key: string]: unknown;
}

const { src, alt, h = 1834, crop = false, class: className = "", eager = false, ...rest } = Astro.props;
---

<div
  class={`relative overflow-hidden rounded-[2.2rem] border-[6px] border-cafe bg-cafe shadow-[0_30px_60px_-20px_rgba(35,28,21,0.45)] ${className}`}
  {...rest}
>
  <img
    src={asset(src)}
    alt={alt}
    width="824"
    height={crop ? 1916 : h}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class={`block w-full rounded-[1.85rem] ${crop ? "aspect-[824/1916] object-cover object-top" : "h-auto"}`}
  />
</div>
