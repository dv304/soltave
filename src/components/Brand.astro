---
import { asset } from "../data/site";

/*
 * Por qué el logo: una mano hecha de herramientas creativas. Mismo texto que el capítulo de identidad de marca de la tesis.
 * Al pasar el cursor (o tocar) una parte, se resalta su paso de construcción.
 */
const parts = [
  { img: "paso1_palma", color: "#E05A47", part: "Pulgar y palma", tool: "Paleta de pintor", text: "Pintura y artes plásticas. La palma sostiene a las demás herramientas, como el oficio sostiene a quien crea." },
  { img: "paso2_cuter", color: "#5FA8D3", part: "Meñique", tool: "Cúter de precisión", text: "Maquetación, modelismo y collage: el corte fino y el detalle." },
  { img: "paso3_pincel", color: "#68B072", part: "Anular", tool: "Pincel", text: "Caligrafía, acuarela y pintura: la pincelada libre, el único trazo curvo." },
  { img: "paso4_regla", color: "#F4C443", part: "Dedo medio", tool: "Regla", text: "Arquitectura y diseño: tres bloques que evocan las falanges y las marcas de medida." },
  { img: "paso5_lapicero", color: "#907CB8", part: "Índice", tool: "Lapicero", text: "Dibujo, ilustración y escritura: la idea que se traza primero." },
];
---

<section id="marca" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="max-w-2xl">
      <p class="font-display text-lg font-semibold text-coral">La marca</p>
      <h2 class="mt-2 font-display text-4xl font-semibold leading-tight sm:text-5xl">Una mano hecha de herramientas</h2>
      <p class="mt-4 text-lg leading-relaxed text-arena">
        El logo es la mano de quien crea y, a la vez, la mano que la app ayuda a rehabilitar. El pulgar y la palma son una paleta de
        pintor y cada dedo es la herramienta de un oficio creativo: así, diseñadores, pintores, ilustradores y arquitectos se
        reconocen en el mismo símbolo, porque comparten el mismo riesgo, la sobrecarga de la mano y la muñeca.
      </p>
    </div>

    <div class="mt-12 grid items-center gap-10 md:grid-cols-[minmax(0,22rem)_1fr] md:gap-16">
      <!-- La mano se arma paso a paso: el logo grande muestra el paso de la parte seleccionada -->
      <div data-reveal class="mx-auto w-full max-w-[18rem] md:max-w-none">
        <div class="relative aspect-square">
          {parts.map((p, i) => (
            <img
              data-brand-img={i}
              src={asset(`/img/marca/${p.img}.webp`)}
              alt={i === parts.length - 1 ? "Logo de Soltá Ve: una mano formada por una paleta, un cúter, un pincel, una regla y un lapicero" : ""}
              width="400" height="400" loading="lazy"
              class:list={["absolute inset-0 h-full w-full transition-opacity duration-300", i === parts.length - 1 ? "opacity-100" : "opacity-0"]}
            />
          ))}
        </div>
        <p class="mt-3 text-center text-sm text-arena">Toca cada parte para ver cómo se construyó.</p>
      </div>

      <ol data-stagger class="grid gap-3 sm:grid-cols-2">
        {parts.map((p, i) => (
          <li>
            <button type="button" data-brand-part={i} class="flex h-full w-full items-start gap-4 rounded-2xl bg-white p-4 text-left ring-1 ring-linea transition-shadow hover:shadow-md">
              <span class="mt-1 h-10 w-10 shrink-0 rounded-xl" style={`background:${p.color}`}></span>
              <span>
                <span class="block text-xs font-semibold uppercase tracking-wide text-arena">{i + 1}. {p.part}</span>
                <span class="mt-0.5 block font-display text-xl font-semibold">{p.tool}</span>
                <span class="mt-1 block text-sm leading-relaxed text-arena">{p.text}</span>
              </span>
            </button>
          </li>
        ))}
        <li class="rounded-2xl bg-crema p-4 sm:col-span-2">
          <span class="block font-display text-xl font-semibold">¿Por qué «Soltá Ve»?</span>
          <span class="mt-1 block text-sm leading-relaxed text-arena">
            «Soltá» viene de soltar: soltar la mano, la tensión y la rigidez que deja crear durante horas, dicho con el voseo caleño.
            «Ve» es como se habla en Cali («¡soltá eso, ve!»), para que suene a consejo de amigo y no a indicación clínica. Los dedos
            abiertos en abanico son el gesto que la app enseña: la mano que trabaja todo el día también aprende a soltarse.
          </span>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  [data-brand-part][aria-pressed="true"] {
    box-shadow: 0 0 0 2px var(--color-coral);
  }
</style>

<script>
  // Seleccionar una parte muestra el logo hasta ese paso de construcción; sin selección se ve completo.
  const imgs = document.querySelectorAll<HTMLElement>("[data-brand-img]");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-brand-part]");
  const last = imgs.length - 1;
  let selected = -1;
  const show = (i: number) => imgs.forEach((img, k) => img.classList.toggle("opacity-0", k !== i));
  buttons.forEach((btn) => {
    const i = Number(btn.dataset.brandPart);
    btn.addEventListener("click", () => {
      selected = selected === i ? -1 : i;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.brandPart) === selected)));
      show(selected < 0 ? last : selected);
    });
    btn.addEventListener("mouseenter", () => show(i));
    btn.addEventListener("mouseleave", () => show(selected < 0 ? last : selected));
  });
</script>
